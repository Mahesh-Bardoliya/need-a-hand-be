# --- Application Settings ---

# App secret key used for JWT signing and other cryptographic operations.
# Change this to a long, random string in production.
# Default: development-secret-key-do-not-use-in-production
# SECRET_KEY=

# Application environment (e.g., development, production, testing).
# In non-development environments, OpenAPI/Swagger docs are hidden for security.
# Default: development
# ENVIRONMENT=

# --- Database Settings ---

# SQLAlchemy Database URL.
# SQLite example: sqlite:///./need_a_hand.db
# Postgres example: postgresql://user:password@localhost:5432/dbname
# Default: sqlite:///./need_a_hand.db
# SQLALCHEMY_DATABASE_URL=

# Postgres configurations (Used mainly with Docker/Production).
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=need_a_hand

# --- Security & Auth Settings ---

# Allowed CORS origins, separated by commas.
# Controls which frontend domains can interact with this API.
# Default: (localhost and 127.0.0.1 variants)
# CORS_ALLOW_ORIGINS=

# JWT Algorithm used for signing tokens (e.g., HS256, RS256).
# Default: HS256
# JWT_ALGORITHM=

# How long an access token remains valid before expiring.
# Default: 60
# ACCESS_TOKEN_EXPIRE_MINUTES=
